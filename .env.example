# --- Models ---------------------------------------------------------------------------------
LLM_PROVIDER=openai                 # openai | anthropic
FALLBACK_PROVIDER=anthropic         # used on the last retry and when the primary is misconfigured
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # EU residency projects: https://eu.api.openai.com/v1
OPENAI_AGENT_MODEL=gpt-5.6-sol      # check the exact id your project has: GET /v1/models
OPENAI_GUARD_MODEL=gpt-5.4-mini     # smaller, cheaper model for the injection screen
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-opus-5-5
ANTHROPIC_GUARD_MODEL=claude-haiku-5-5
AGENT_EFFORT=medium

# --- Knowledge base -------------------------------------------------------------------------
QDRANT_URL=https://<cluster>.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks
EMBEDDING_PROVIDER=openai           # openai | local (fastembed, nothing leaves the box)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
NOTION_TOKEN=                       # only for `ingest --notion-database`

# --- Observability (EU region) --------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Zendesk --------------------------------------------------------------------------------
ZENDESK_SUBDOMAIN=                  # unset = tickets recorded locally (dev)
ZENDESK_AUTH_MODE=oauth             # oauth | api_token
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_REDIRECT_URI=http://localhost:8000/v1/zendesk/oauth/callback
ZENDESK_EMAIL=                      # api_token mode only
ZENDESK_API_TOKEN=                  # api_token mode only
ZENDESK_WEBHOOK_SECRET=             # signing secret of the "ticket solved" webhook
SUPPORT_EMAIL=support@example.com

# --- Shop backend ---------------------------------------------------------------------------
COMMERCE_API_URL=                   # unset = demo orders
COMMERCE_API_KEY=

# --- App secrets (required outside dev) -----------------------------------------------------
ENV=dev
DATABASE_URL=postgresql://shopdesk:shopdesk@localhost:5433/shopdesk
WIDGET_JWT_SECRET=                  # shared with the storefront that signs shopper tokens
ADMIN_TOKEN=                        # basic-auth password for /v1/admin/* and the OAuth connect
TOKEN_ENCRYPTION_KEY=               # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PSEUDONYM_KEY=                      # python -c "import secrets; print(secrets.token_hex(32))"
CONVERSATION_TTL_DAYS=30
CORS_ORIGINS=["https://shop.example.com"]
